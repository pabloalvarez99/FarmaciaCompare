{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "esModuleInterop": true } }]
  },
  "moduleNameMapper": {
    "^@farmacia/database$": "<rootDir>/../../../packages/database/dist/index.js",
    "^@farmacia/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts"
  }
}
