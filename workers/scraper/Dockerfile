# Scraper worker image.
#
# Build context is the REPO ROOT (same convention as services/api-gateway):
#   docker build -f workers/scraper/Dockerfile -t <image> .
#
# Runs the scraper CLI. Cloud Run Job passes the subcommand as container args,
# e.g. args=["scrape","farmex"] or args=["scrape-all"].
#
# Notes:
# - poetry.lock was generated by Poetry 2.4.1 (lock-version 2.1), so the image
#   pins that major version — Poetry <2.1 refuses to read the lockfile.
# - No `playwright install`: the only browser scraper is the legacy
#   src/pharmacies/dr_simi.py, which src/registry.py does not reference (dr_simi
#   goes through the VTEX HTTP connector). Downloading Chromium + its apt deps
#   would add ~700 MB for dead code.

FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=true \
    POETRY_VIRTUALENVS_IN_PROJECT=true

WORKDIR /app

RUN pip install "poetry==2.4.1"

# Only the dependency manifests, so this layer caches across src/ edits.
COPY workers/scraper/pyproject.toml workers/scraper/poetry.lock ./

# --only main drops pytest/coverage; --no-root skips installing src itself
# (it is copied in below and imported as a plain package from /app).
RUN poetry install --only main --no-root


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY workers/scraper/src ./src

# Standalone maintenance script, run by the `scraper-reaper` Cloud Run Job with
# an overridden command (`python /app/scripts/reap_stale_jobs.py`). It rides in
# this image only to reuse the venv — it imports nothing from src/.
COPY scripts/reap_stale_jobs.py ./scripts/reap_stale_jobs.py

RUN useradd --create-home --uid 1001 scraper && chown -R scraper:scraper /app
USER scraper

ENTRYPOINT ["python", "-m", "src.cli"]
CMD ["scrape-all"]
